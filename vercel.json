{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:page(blog|blog-index|careers|help|how-it-works|location|login|partners|relocation|rentals|safety|signup)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:page(blog|blog-index|careers|help|how-it-works|location|login|partners|relocation|rentals|safety|signup).html",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
